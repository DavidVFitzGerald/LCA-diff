#!/usr/bin/env bash
# Host-side Docker lifecycle only; no host runtimes or package managers.
set -euo pipefail
repo_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"
if [[ "${LCA_DEV_CONTAINER:-}" == 1 ]]; then
    echo 'Run ./dev on the Docker host. Use the container terminal for development.' >&2
    exit 1
fi
compose=(docker compose --project-directory "$repo_dir" --file "$repo_dir/compose.yaml")
publication_compose=("${compose[@]}" --file "$repo_dir/compose.etl.yaml" --file "$repo_dir/compose.publication.yaml")
if [[ -n "${LCA_PUBLICATION_OVERRIDE:-}" ]]; then
    [[ -f "$LCA_PUBLICATION_OVERRIDE" ]] || { echo 'Publication override file does not exist.' >&2; exit 1; }
    publication_compose+=(--file "$LCA_PUBLICATION_OVERRIDE")
fi
# The local application stack pins its own project name (never COMPOSE_PROJECT_NAME),
# so its volumes cannot be the disposable databases that test suites reset.
app_project="${LCA_APP_PROJECT:-lca-diff-app}"
if [[ ! "$app_project" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo 'LCA_APP_PROJECT must be a lowercase Compose project name.' >&2
    exit 2
fi
export LCA_APP_PROJECT="$app_project"
# Refuse a workspace collision before ANY Compose call (including config/ps).
# Do not source .env: it is configuration, never executable shell input.
if [[ "${1:-}" == app-* ]]; then
    workspace_project="${COMPOSE_PROJECT_NAME:-}"
    if [[ ! -v COMPOSE_PROJECT_NAME && -f "$repo_dir/.env" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?COMPOSE_PROJECT_NAME[[:space:]]*=[[:space:]]*(.*)$ ]]; then
                workspace_project="${BASH_REMATCH[2]}"
                workspace_project="${workspace_project%%[[:space:]]#*}"
                workspace_project="${workspace_project%$'\r'}"
                workspace_project="${workspace_project%"${workspace_project##*[![:space:]]}"}"
                if [[ "$workspace_project" == \"*\" || "$workspace_project" == \'*\' ]]; then
                    workspace_project="${workspace_project:1:${#workspace_project}-2}"
                fi
                if [[ "$workspace_project" == *'$'* || "$workspace_project" == *'`'* ]]; then
                    echo 'Set COMPOSE_PROJECT_NAME explicitly in the environment for app-*; interpolated .env project names cannot be checked safely.' >&2
                    exit 2
                fi
            fi
        done < "$repo_dir/.env"
    fi
    workspace_project="${workspace_project:-lca-diff-dev}"
    if [[ "$app_project" == "$workspace_project" ]]; then
        echo "LCA_APP_PROJECT '$app_project' must differ from workspace project '$workspace_project'; no containers were changed." >&2
        exit 2
    fi
fi
app_compose=(docker compose --project-name "$app_project" --project-directory "$repo_dir" --file "$repo_dir/compose.app.yaml")
app_port() {
    local variable="$1" value="${!1-$2}" line
    # Resolve a literal .env setting only when the process environment did not
    # define it. Never source/eval configuration; interpolation is not a port.
    if [[ ! -v "$variable" && -f "$repo_dir/.env" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?$variable[[:space:]]*=[[:space:]]*(.*)$ ]]; then
                value="${BASH_REMATCH[2]}"
                value="${value%%[[:space:]]#*}"
                value="${value%$'\r'}"
                value="${value%"${value##*[![:space:]]}"}"
                if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
                    value="${value:1:${#value}-2}"
                fi
            fi
        done < "$repo_dir/.env"
    fi
    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        echo "$variable must be an integer from 1 to 65535." >&2
        return 2
    fi
    # Strip leading zeros before arithmetic: no octal interpretation or overflow,
    # even for arbitrarily long inputs. The remaining value has at most 5 digits.
    value="${value#"${value%%[!0]*}"}"
    if [[ -z "$value" || "${#value}" -gt 5 ]] || (( 10#$value > 65535 )); then
        echo "$variable must be an integer from 1 to 65535." >&2
        return 2
    fi
    printf '%s\n' "$value"
}
if [[ "${1:-}" == app-* ]]; then
    app_frontend_port="$(app_port LCA_APP_FRONTEND_PORT 5180)"
    app_api_port="$(app_port LCA_APP_API_PORT 8010)"
    app_auth_port="$(app_port LCA_APP_AUTH_PORT 9110)"
    # Compose receives the same canonical decimal values used by the port probe.
    export LCA_APP_FRONTEND_PORT="$app_frontend_port"
    export LCA_APP_API_PORT="$app_api_port"
    export LCA_APP_AUTH_PORT="$app_auth_port"
fi
app_ports_free() {
    # A running stack legitimately owns its ports; only check before a fresh start.
    [[ -z "$("${app_compose[@]}" ps --quiet)" ]] || return 0
    local entry
    for entry in "LCA_APP_FRONTEND_PORT:$app_frontend_port" "LCA_APP_API_PORT:$app_api_port" "LCA_APP_AUTH_PORT:$app_auth_port"; do
        if (exec 3<>"/dev/tcp/127.0.0.1/${entry#*:}") 2>/dev/null; then
            echo "Host port 127.0.0.1:${entry#*:} (${entry%%:*}) is already in use. Free it or set ${entry%%:*} to another port." >&2
            exit 1
        fi
    done
}
app_summary() {
    cat <<SUMMARY
Local app stack '$app_project' is healthy (local-only development credentials):
  Frontend   http://127.0.0.1:$app_frontend_port  (real API and Firebase Auth Emulator)
  API        http://127.0.0.1:$app_api_port/api/v1/health  and  /api/v1/ready
  Auth       127.0.0.1:$app_auth_port  (Firebase Auth Emulator, project demo-lca)
  Demo login demo@example.com / local-demo-password-not-secret  (emulator only)
SUMMARY
}
case "${1:-help}" in
    build|up|down|shell|check|logs|backend-up|backend-down|etl-up|etl-shell|etl-run|airflow-up|api-up|api-down|auth-up|publication-up|publication-run|app-up|app-down|app-reset|app-status|app-logs|app-smoke|app-import|app-e2e)
        bash "$repo_dir/.devcontainer/check-docker.sh" ;;
    config|app-config|help) ;;
    *) echo "Unknown command: $1" >&2; exit 2 ;;
esac
case "${1:-help}" in
    build) "${compose[@]}" build workspace ;;
    up) "${compose[@]}" up --detach --build workspace ;;
    backend-up) "${compose[@]}" --profile backend up --detach --wait postgres workspace ;;
    backend-down) "${compose[@]}" stop postgres ;;
    etl-up) "${compose[@]}" --file "$repo_dir/compose.etl.yaml" --profile backend --profile etl up --detach --build --wait postgres etl ;;
    etl-shell) "${compose[@]}" --file "$repo_dir/compose.etl.yaml" exec etl bash ;;
    etl-run) shift; "${compose[@]}" --file "$repo_dir/compose.etl.yaml" exec -T etl bash -c 'exec "$@"' bash "$@" ;;
    publication-up) "${publication_compose[@]}" --profile backend --profile etl --profile publication up --detach --build --wait postgres postgres-target etl ;;
    publication-run) shift; "${publication_compose[@]}" exec -T etl bash -c 'exec "$@"' bash "$@" ;;
    airflow-up) "${compose[@]}" --file "$repo_dir/compose.etl.yaml" --profile backend --profile etl --profile airflow up --detach --build postgres etl airflow-init airflow-api airflow-scheduler airflow-dag-processor ;;
    api-up) "${compose[@]}" --profile backend --profile api up --detach --build postgres auth api workspace ;;
    api-down) "${compose[@]}" stop api auth ;;
    auth-up) "${compose[@]}" --profile auth up --detach --build auth ;;
    down) "${compose[@]}" down ;;
    shell) "${compose[@]}" exec workspace bash ;;
    check) "${compose[@]}" exec -T workspace bash .devcontainer/check-env.sh ;;
    logs) "${compose[@]}" logs --tail=100 workspace ;;
    config) "${compose[@]}" config --quiet ;;
    app-config) "${app_compose[@]}" config --quiet ;;
    app-up) app_ports_free; "${app_compose[@]}" up --detach --build --wait --remove-orphans; app_summary ;;
    app-down) "${app_compose[@]}" down --remove-orphans ;;
    app-reset)
        if [[ "${2:-}" != --yes ]]; then
            echo "Refusing to delete the '$app_project' database and archive volumes. Re-run: ./dev app-reset --yes" >&2
            exit 1
        fi
        "${app_compose[@]}" down --volumes --remove-orphans ;;
    app-status) shift; "${app_compose[@]}" ps --all "$@" ;;
    app-logs) shift; "${app_compose[@]}" logs --tail=200 "$@" ;;
    app-smoke) "${app_compose[@]}" --profile smoke run --rm --no-deps smoke ;;
    app-e2e) "${app_compose[@]}" --profile e2e build e2e; shift; "${app_compose[@]}" --profile e2e run --rm --no-deps e2e "$@" ;;
    app-import) shift; "${app_compose[@]}" --profile import run --rm --no-deps import "$@" ;;
    help)
        echo 'Usage: ./dev {build|up|shell|check|down|logs|config|backend-up|backend-down|api-up|api-down|auth-up|etl-up|etl-shell|etl-run|airflow-up|publication-up|publication-run}'
        echo '       ./dev {app-config|app-up|app-down|app-reset [--yes]|app-status|app-logs [service]|app-smoke|app-e2e|app-import <lca-import args>}'
        echo 'Requires a rootless Docker daemon; run development tools inside its workspace.' ;;
esac
